# ★ CI 检查脚本必须**字节一致**地检出。
#
#   本机 core.autocrlf=true：Windows 检出会把 LF 转成 CRLF。Python 能解析 CRLF 源码，
#   但 scripts/ 下的脚本是"用字符串样例当输入"的门禁——样例文本里会混入 \r，
#   于是"本地跑得通、CI 跑不通"又多一个来源（本轮已实测：两个脚本在 CRLF 下自测
#   都通过，但这是**结果**，不该依赖运气）。
#   强制 LF，任何平台 checkout 出来的字节都一样。
scripts/*.py text eol=lf
# ★ 子目录脚本同理：黄金样本工具链在 scripts/golden/ 下，上面的 scripts/*.py 匹配不到它
#   （glob 的 * 不跨目录），漏掉的后果是子目录脚本在 Windows 检出成 CRLF。
scripts/**/*.py text eol=lf
# ★ shell 脚本必须是 LF：CRLF 会让 bash 把 \r 当成参数的一部分直接报错
#   （典型的 "cannot execute: required file not found" 或 "invalid option"）。
scripts/**/*.sh text eol=lf

# 工作流同理：GitHub Actions 容忍 CRLF，但一旦换行不一致，
# 每次改动都会变成整文件重写，diff 完全失去可读性。
.github/workflows/*.yml text eol=lf

# ★ P2-06：根 wrapper 是单根化后**唯一**的本地 Gradle 入口（M4 已删两端 wrapper）。
#   gradlew 是以 `#!/bin/sh` 开头的可执行脚本，若检出成 CRLF，Linux/macOS 或容器里的
#   bash 会把 `\r` 当成解释器路径的一部分，直接报
#   `bad interpreter: /bin/sh^M: no such file or directory`。
#   强制 LF，保证任何平台 checkout 后都能直接 `./gradlew`。
gradlew text eol=lf
# gradlew.bat 走 Windows cmd，保持 CRLF 更稳（cmd 对 LF-only 的 batch 有已知解析坑）。
gradlew.bat text eol=crlf

# 随包 adb 二进制：按 binary 处理，避免换行转换损坏可执行文件
desktop/ui/appResources/**/*.exe binary
desktop/ui/appResources/**/*.dll binary
